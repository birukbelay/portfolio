# ============================================================
# AUTHENTICATION (NextAuth v5 / Auth.js)
# ============================================================
# Generate a secret using: openssl rand -base64 32
AUTH_SECRET="your-generated-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Whitelist of emails authorized to access the /admin panel (comma-separated):
ADMIN_EMAILS="birukbelay@gmail.com,admin@portfolio.local"

# GitHub OAuth credentials (from https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Default fallback credentials for local admin login
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="admin123"

# ============================================================
# DATABASE (Cloudflare D1 / SQLite with Drizzle ORM)
# ============================================================
# D1 is the primary database. portfolio.db (committed to git) is the fallback:
#   - reads use portfolio.db whenever D1 is unreachable or these vars are empty
#   - writes go to both; if D1 is down they're queued locally and replayed by `pnpm db:sync`
#   - `pnpm dev` runs `pnpm db:sync` first: D1 -> portfolio.db, then commit + push if changed
#
# Account ID: Cloudflare Dashboard > Account home > "..." menu next to the account > Copy account ID
CLOUDFLARE_ACCOUNT_ID=""
# Database ID: output of `npx wrangler d1 create portfolio`, or Dashboard > Storage & Databases > D1
CLOUDFLARE_D1_DATABASE_ID=""
# API token: Dashboard > Manage Account > Account API Tokens > Create Token > Custom token
#   Permissions: Account | D1 | Edit     Account Resources: Include | <your account>
CLOUDFLARE_D1_API_TOKEN=""

# Optional
# D1_TIMEOUT_MS="5000"        # how long to wait for D1 before falling back to portfolio.db
# DB_SYNC_COMMIT="false"      # stop `pnpm db:sync` from committing portfolio.db
# DB_SYNC_PUSH="false"        # commit, but don't push
# LOCAL_DB_URL="file:portfolio.db"

# ============================================================
# FILE STORAGE (any S3-compatible object storage: Supabase Storage, Cloudflare R2, AWS S3…)
# ============================================================
# Local:    uploads are saved to public/assets/uploads AND to storage (if configured).
#           `pnpm db:sync` keeps both copies in sync and commits the folder.
# Deployed: uploads go to storage only; the upload fails if storage is missing or down.
STORAGE_ENDPOINT=""          # e.g. https://<project>.storage.supabase.co/storage/v1/s3
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="portfolio"
STORAGE_PUBLIC_URL=""        # public base URL of the bucket, e.g. https://<project>.supabase.co/storage/v1/object/public/portfolio
# (R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET_NAME / R2_PUBLIC_URL also work)

# ============================================================
# RUNTIME MODE
# ============================================================
# Detected automatically: "deployed" on Vercel, "local" everywhere else.
# In deployed mode every change must reach the real backends (D1 for text, storage for files)
# or it fails. Override with APP_MODE=deployed to test that behaviour locally.
# APP_MODE="local"
